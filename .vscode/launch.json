    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Subscribe OM",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/examples/subscribe_object_model.py",
            "console": "integratedTerminal",
            "autoReload": {
                "enable": true
            },
            "justMyCode": false,
            "cwd": "${workspaceFolder}/src",
