<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- Path to a DuetSoftwareFramework checkout, override with -p:DsfPath=<path> -->
		<DsfPath Condition="'$(DsfPath)' == ''">$(MSBuildThisFileDirectory)../../../DuetSoftwareFramework</DsfPath>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="$(DsfPath)/src/DuetAPI/DuetAPI.csproj" />
	</ItemGroup>

</Project>
